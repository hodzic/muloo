{
  "name": "MuLoo",
  "short_name": "MuLoo",
  "description": "Tuner, metronome, score viewer and practice recorder for guitar and ukulele.",
  "id": "/muloo/",
  "start_url": "/muloo/",
  "scope": "/muloo/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0f12",
  "theme_color": "#0e0f12",
  "icons": [
    { "src": "/muloo/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/muloo/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/muloo/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/muloo/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "score", "accept": ["application/pdf", ".pdf"] }]
    }
  },
  "file_handlers": [
    { "action": "/muloo/#scores", "accept": { "application/pdf": [".pdf"] } }
  ]
}
